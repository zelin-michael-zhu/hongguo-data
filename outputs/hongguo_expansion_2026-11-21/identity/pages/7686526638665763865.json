{"series_id":"7686526638665763865","url":"https://hongguoduanju.com/detail?series_id=7686526638665763865","fetched_at_utc":"2026-11-21T07:12:10+00:00","http_status":200,"html_sha256":"1835a152208ed46f3ea1ef66c93267773a18673d3356f6545aab4a4cf79c9e9f","returned_detail_keys":["episode_cnt","accessible_episode_cnt","pay_type","series_id","series_name","series_cover","series_intro","tags","episode_right_text","celebrities","series_episode_info","vid_list","first_visible_time","season_info","record_number"],"returned_social_keys":["rating","series_like_count","series_favorite_count","rating_count","hot_score_data","reviews"],"detail":{"series_name":"高冷千金的贴身高手第2季","series_id":"7686526638665763865","series_intro":"林初雪登顶顶流编剧，钱多多却饱受非议。倒插门入顾家的过往，童年被扣上外姓人帽子的屈辱记忆，伴着周遭的闲言碎语与豪门冷眼，啃噬着他仅剩的骄傲。剧组风波爆发，林初雪无心的话语成为导火索，钱多多忍痛恶语分手，不久顾家老管家带来遗嘱，钱多多是顾氏原始股份继承人，他重整心绪投身商战，争夺顾家权柄。二人因项目重逢，公事相争，情愫难掩。旧日情愫从未消散，身份鸿沟仍横亘在前，昔日爱人破镜能否重圆？","first_visible_time":"1789889580","record_number":"（番茄）网微剧备字（2026）第978977号","series_episode_info":{"episode_cnt":249,"episode_total_cnt":249,"series_status":1},"episode_cnt":249,"accessible_episode_cnt":3,"episode_right_text":"全249集","season_info":{"series_group_id":"7673370205455666200"},"vid_list":["7686585864918404120","7686586139846659096","7686586100529237016","7686585930890628120","7686585825575832600","7686585883578879000","7686586195593153560","7686586234038144024","7686585995088628760","7686586015984667672","7686585962830253080","7686586127842561048","7686586012323040280","7686586059483794456","7686585861189667864","7686586209216252952","7686585999761083416","7686586073383701528","7686586017393937432","7686585955343404056","7686585866461907992","7686585968794553368","7686586213070801944","7686586053049715736","7686586080488868888","7686585885264989208","7686585823982046232","7686586056434519064","7686585939652512792","7686586098474044440","7686585846182448152","7686585933910510616","7686585987241102360","7686586256842574872","7686586202023021592","76865859493958973