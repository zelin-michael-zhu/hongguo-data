{"series_id":"7687189939640880152","url":"https://hongguoduanju.com/detail?series_id=7687189939640880152","fetched_at_utc":"2026-11-21T07:12:17+00:00","http_status":200,"html_sha256":"ee551067d79539b4414a0b565ab555a529d09dd5d50ad3333dc06db4fa202481","returned_detail_keys":["episode_cnt","accessible_episode_cnt","pay_type","series_id","series_name","series_cover","series_intro","tags","episode_right_text","celebrities","series_episode_info","vid_list","first_visible_time","record_number"],"returned_social_keys":["rating","series_like_count","series_favorite_count","rating_count","hot_score_data","reviews"],"detail":{"series_name":"人鱼赴归潮","series_id":"7687189939640880152","series_intro":"深海捞到人鱼？渔民周海生为救重病妻子，意外网住鲛人阿澜。阿澜以自愿之泪凝作珍珠换自由，珍珠卖出天价，救妻还债绰绰有余。可贪念一旦生根，周海生反手将她囚禁废弃盐屋，铁链锁身逼她再落鲛珠。守灯人谢临舟从黑礁救下濒死的阿澜，以尊重换信任。鲛泪成珠，唯真心自愿方能成形。一场关于善意、贪婪与自由的深海人性寓言。","first_visible_time":"1789880280","record_number":"（番茄）网微剧备字（2026）第988595号","series_episode_info":{"episode_cnt":88,"episode_total_cnt":88,"series_status":1},"episode_cnt":88,"accessible_episode_cnt":3,"episode_right_text":"全88集","vid_list":["7687191714401881113","7687191747826306073","7687191849450081305","7687191720403930137","7687191693338102809","7687191834182831129","7687191680771968025","7687191774250404889","7687191783503055897","7687191750082841625","7687191840008703001","7687191843452226585","7687191816738720793","7687191723633544217","7687191841610943513","7687191756940528665","7687191772400733209","7687191855657651225","7687191695481392153","7687191867523337241","7687191862322400281","7687191687440895001","7687191691144481817","7687191811814607897","7687191810317224985","7687191752641350681","7687191712547998745","7687191786116107289","7687191699398872089","7687191827853626393","7687191865061280793","7687191788678810649","7687191706441092121","7687191851345923097","7687191745674628121","7687191859579325465","7687191754646244377","7687191790759185433","7687191765975043097","7687191738061949977","7687191718113840153","7687191