7695824013922143294","7695824004099099710","7695823987581930558","7695823897320492094","7695824023711648830","7695824009664924734","7695823867310246974","7695823877275929662","7695823925804010558","7695823887690386494","7695824027213909054","7695823865313774654","7695823861413071934","7695823932540079166","7695823857747250238","7695824025443896382","7695823992749313086","7695823962101533758","7695823941704617022","7695823937078316094","7695823885937167422","7695823883739352126","7695823869315140670","7695823923065130046","7695823853078973502","7695823975753993278","7695823902441737278","7695823904786369598","7695823998558407742","7695823986013260862","7695823879956089918","7695823930489048126","7695823939288697918","7695823850528836670","7695824000324226110","7695824020310068286","7695823982284524606","7695823965733784638","7695823906560560190","7695824007827819582","7695823881977728062","7695824005764222014"],"tags":["成长","女性成长","家庭伦理","虐渣","揭露阴谋","逆风翻盘","大女主","极品亲戚","现代"],"pay_type":0,"celebrities":[{"nickname":"岳玥","sub_title":"饰 安柠","celebrity_id":"7410379519955047705","is_label":false},{"nickname":"黄骞","sub_title":"饰 周明海","celebrity_id":"7460020537922704702","is_label":false},{"nickname":"陈雨萱 (洛一)","sub_title":"饰 周念安","celebrity_id":"7529480086269990206","is_label":false},{"nickname":"小冰","sub_title":"饰 小文","celebrity_id":"7663425832513195070","is_label":false},{"nickname":"余晗","sub_title":"饰 周明珠","celebrity_id":"7556068044104029502","is_label":false},{"nickname":"琦琦","sub_title":"饰 周梦瑶","celebrity_id":"7588812215071823166","is_label":false},{"nickname":"银子","sub_title":"饰 某亲戚","celebrity_id":"7665549560973888574","is_label":false},{"nickname":"温书妤","sub_title":"饰 招生办老师","celebrity_id":"7549841720599401790","is_label":false},{"nickname":"郭菲","sub_title":"饰 某民政局办证员","celebrity_id":"7602848483317388568","is_label":false},{"nickname":"张梦童","sub_title":"饰 苏婉","celebrity_id":"7535348795865830718","is_label":false}]},"social":{"rating":8.1,"series_like_count":"749000","series_favorite_count":"299000","rating_count":"418","rank_label":"真人剧热播榜第54名","hot_score_data":{"score":46715771,"text":"4671万热度"},"reviews":{"total_count":"16","reviews":[{"create_time":"1792456776","content":"这部短剧把很多中年夫妻的隐忍戳得明明白白，机场刷到朋友圈那一幕，看得人心里堵得慌。不刻意煽情，却把攒了二十年的委屈全演出来了。\n 没有狗血撒泼，全是攒了多年的失望，高考结束不是终点，是母女俩重新为自己活的开始。\n 节奏不拖沓，每一处细节都很真实，看完特别能理解女主最后选择离婚的决定。","digg_count":"156","rating":9},{"create_time":"1793497281","content":"周明海：\n最近播出的这部剧很受大家喜欢，作为周明海扮演者我也倍感欣慰，回想当初拿到剧本的时候就被故事内容吸引感慨，有一些话，我想替周明海来给大家说一说。\n我是周明海。回头看，我这一生，都活在“要面子”三个字里。\n我骨子里很懦弱，一边摆脱不了原生家庭的裹挟，又贪恋婚外的慰藉。我明知亏欠安柠母女，却不愿承认自己的过错。得知周念安是省状元，我放下身段讨好，可转头又被苏婉拿腹中孩子拿捏。听说周家老宅即将拆迁，我才惊觉自己稀里糊涂把千万家产拱手送人，那一刻我彻底慌了神。\n为了想要一个儿子，我铤而走险伪造证件做试管；为供养苏婉母女，我不惜挪用公司公款。很多时刻我不是没有犹豫，可虚荣心和侥幸心理压倒了良知。祠堂那场闹剧，我本想借着女儿光宗耀祖，最后却当众被撕开所有不堪。\n我总觉得万事都有余地，总以为能用手段摆平一切，直到证据一件件摆到面前，我才明白，所有的选择都早已标好了代价。\n最后再次感谢喜欢大家的支持，希望以后能带给你们更多的好剧。","digg_count":"49","rating":10},{"create_time":"1793260400","content":"我是小演员陈雨萱(洛一），大家好呀\n在剧中饰演那个困在压抑原生家庭里、外表安静却内心清醒的少女——周念安。\n大家都以为周念安只是个埋头读书的乖乖考生，可剥开她沉静内敛的外表下，我看见了最通透的眼光、最坚韧的勇气、最滚烫的守护……\n沉默寡言的外表之下，她有着远超同龄人的洞察力与共情，分得清善恶真假，看懂人情凉薄，拼尽全力守护自己唯一珍视的母亲。\n深知母亲困在婚姻里失去自我，独立是她找回自我唯一的道路，所以一直懂事内敛的周念安，愿意鼓起勇气直面所有风波，和母亲互相支撑，挣脱原生泥潭，母女二人不靠他人，活出自在耀眼的人生，真好。\n谢谢大家对剧集和人物的喜爱和支持，深表感谢~","digg_count":"25","rating":10},{"create_time":"1795053268","content":"这本短剧很贴近生活，女人一生不能以家庭为重，而是要以事业为重，在儿女面前才含被看得起","digg_count":"0","rating":9},{"create_time":"1794280367","content":"渣男在外用假结婚证骗婚并生儿育女，对妻子女儿却一毛不拔，还要妻子当牛做马，殊不知在外骗婚买房买车的钱都是贪污得来，东窗事发后，被判处有期徒刑八年，最后落得个人财两空、身败名裂的下场。","digg_count":"0","rating":10},{"create_time":"1792651633","content":"剧情不错演员演技很好[赞][赞][赞]","digg_count":"16","rating":10},{"create_time":"1794138557","content":"辛苦了，很好看，感人感事！","digg_count":"6","rating":9},{"create_time":"1793441820","content":"[没看够]强烈推荐。","digg_count":"6","rating":10},{"create_time":"1792934014","content":"这部好好看，我家人也喜欢看","digg_count":"9","rating":10}]}}}
