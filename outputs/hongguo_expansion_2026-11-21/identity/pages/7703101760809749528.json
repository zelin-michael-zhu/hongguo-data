{"series_id":"7703101760809749528","url":"https://hongguoduanju.com/detail?series_id=7703101760809749528","fetched_at_utc":"2026-11-21T07:19:10+00:00","http_status":200,"html_sha256":"49c9a5fe03abc9803ed7a8dfb0ecb4338e946b4edd529dd15a2c081748c34bdf","returned_detail_keys":["episode_cnt","accessible_episode_cnt","pay_type","series_id","series_name","series_cover","series_intro","tags","episode_right_text","celebrities","series_episode_info","vid_list","first_visible_time","season_info","record_number"],"returned_social_keys":["rating","series_like_count","series_favorite_count","rating_count","hot_score_data","reviews"],"detail":{"series_name":"魔神人生：弃子问天第二季","series_id":"7703101760809749528","series_intro":"叶秋背负魔神血脉，身世坎坷，游走在魔道与儒道之间。荒古战场风波骤起，他被三千州万族视作魔头，多方势力对他围追绞杀。挚友、长辈接连为他身陷险境，外公苏潮风被天界掳走，兄弟叶清走向癫狂。叶秋意外坠入海底轮回仙宫，直面轮回试炼，对抗异界来客葬主。他一边要应对万族与天界的重重追杀，一边追寻力量，想要救出亲人、守护身边之人，在魔与道的夹缝之中走出属于自己的道路。","first_visible_time":"1793549161","record_number":"（番茄）微短剧备字（2026）第265790号","series_episode_info":{"episode_cnt":586,"episode_total_cnt":586,"series_status":1},"episode_cnt":586,"accessible_episode_cnt":3,"episode_right_text":"全586集","season_info":{"series_group_id":"7693061703096863768"},"vid_list":["7703104484339108889","7703104424868072473","7703104182345026585","7703103906082999321","7703103736909941785","7703103670975466521","7703104101575314457","7703104167715294233","7703104303895940121","7703103522765540377","7703103387369212953","7703103517111618585","7703104116666420249","7703104205401099289","7703103805553921049","7703103468684184601","7703103781583457305","7703104251718798361","7703103431006751769","7703103868942421017","7703103554348649497","7703103890379525145","7703103727271414809","7703103787249978393","7703103383963454489","7703103974865374233","7703104065416203289","7703104275211111449","7703103626712976409","7703103325226404889","7703103491513781273","7703104212523027481","7703104411924450329","7703104074014526489","7703103551039343641","7703104386750237721","7703103715