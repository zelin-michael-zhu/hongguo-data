{"series_id":"7704990942264036377","url":"https://hongguoduanju.com/detail?series_id=7704990942264036377","fetched_at_utc":"2026-11-21T07:20:28+00:00","http_status":200,"html_sha256":"5a15fc708d457bfba479690f41a41bbf6a17e708b987a9c63470498eac980872","returned_detail_keys":["episode_cnt","accessible_episode_cnt","pay_type","series_id","series_name","series_cover","series_intro","tags","episode_right_text","celebrities","series_episode_info","vid_list","first_visible_time","season_info","record_number"],"returned_social_keys":["rating","series_like_count","series_favorite_count","rating_count","hot_score_data","reviews"],"detail":{"series_name":"谁说没灵根不能修仙的？之无灵证道47季","series_id":"7704990942264036377","series_intro":"韩凡在纸鹤空间寻得第二口轮回棺与灵果古树，再入第九秘境轮回世界重逢故旧。得知人族遭妖神双头邪凤与不死神王奴役，他斩妖神立誓救人。不死神王凭霸王蜥十二命本源愈战愈强，韩凡阵前突破九转仙皇，以长剑吞噬其轮回之力、切断重生。神王屡施绝命反扑，他四度重塑肉身、幻化出混沌噬神蜂，终将其逼服，神王因灵珠被引爆而亡，幕后黑手浮出。锁死空间的诡异红石久攻不破，灭天之战序幕就此拉开。","first_visible_time":"1794240245","record_number":"（番茄）微短剧备字（2026）第299880号","series_episode_info":{"episode_cnt":99,"episode_total_cnt":99,"series_status":1},"episode_cnt":99,"accessible_episode_cnt":3,"episode_right_text":"全99集","season_info":{"series_group_id":"7640040862889544729"},"vid_list":["7704990952737213464","7704990952401669144","7704990952271662104","7704990952334576664","7704990952271645720","7704990953978743832","7704990955052485656","7704990955371252760","7704990956080073752","7704990954779855896","7704990955329293336","7704990956646321176","7704990956977671192","7704990956994432024","7704990957988498456","7704990958802193432","7704990958462438424","7704990959733312536","7704990958995115032","7704990959380991000","7704990959934639128","7704990960572173336","7704990961423617048","7704990960966437912","7704990961562045464","7704990962350558232","7704990962098916376","7704990962677730328","7704990965102021656","7704990963319442456","7704990964158303256","7704990964175096856","7704990964468681752","7704990964992986136","7704990965588560920","7704990965651491864","