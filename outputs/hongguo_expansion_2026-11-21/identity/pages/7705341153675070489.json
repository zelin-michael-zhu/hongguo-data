{"series_id":"7705341153675070489","url":"https://hongguoduanju.com/detail?series_id=7705341153675070489","fetched_at_utc":"2026-11-21T07:20:35+00:00","http_status":200,"html_sha256":"c1f5f5ac4dc6537120fce682a1384d0b1dbe1ed284764fb008a7779df4630d8a","returned_detail_keys":["episode_cnt","accessible_episode_cnt","pay_type","series_id","series_name","series_cover","series_intro","tags","episode_right_text","celebrities","series_episode_info","vid_list","first_visible_time","record_number"],"returned_social_keys":["series_like_count","series_favorite_count","rank_label","hot_score_data","reviews"],"detail":{"series_name":"归国千金不好惹","series_id":"7705341153675070489","series_intro":"陆氏唯一继承人陆昭宁归国，刚下飞机就被准嫂子林虞碰瓷，诬陷她弄丢天价项链，还被保安扔进喷泉。陆昭宁本想亮明身份，可林虞骄横跋扈根本不信。更让她错愕的是，养兄陆聿舟竟认定林虞是当年救过自己妹妹的救命恩人。陆昭宁暗中调查，发现真恩人是林虞的同父异母姐姐林禾，玉扣也是被林虞抢来冒领恩情。婚礼现场，陆昭宁当众放出全部证据，揭穿林虞的谎言。与此同时，野心股东霍峥借机作乱，妄图夺权。","first_visible_time":"1794067444","record_number":"（番茄）微短剧备字（2026）第304599号","series_episode_info":{"episode_cnt":89,"episode_total_cnt":89,"series_status":1},"episode_cnt":89,"accessible_episode_cnt":3,"episode_right_text":"全89集","vid_list":["7705342972442725400","7705343086229982232","7705343084007001112","7705343039576738840","7705343108778560536","7705343110301109272","7705343004902427672","7705342979824700440","7705342983339527192","7705343105146309656","7705343052432280600","7705343062729296920","7705343003019185176","7705343060976077848","7705342984883014680","7705343078835440664","7705343019658005528","7705342996895501336","7705343126302362648","7705343069620554776","7705343010514406424","7705343089967107096","7705343034489064472","7705343093498711064","7705343082316696600","7705343032618404888","7705343026364697624","7705343045629135896","7705343107113438232","7705343101593717784","7705343057775823896","7705343037995486232","7705343096027876376","7705343047365577752","7705342998619376664","7705343111894944792","7705343064591567896","7705342986665610264","7705343097772723224","7705343099978910744","77